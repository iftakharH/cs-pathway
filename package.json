{
  "name": "cs-pathway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A source-verified roadmap, tracker and cheatsheet library for CS students heading into 2027.",
  "scripts": {
    "dev": "npm run content && vite",
    "content": "tsx scripts/build-content.ts",
    "validate": "tsx scripts/validate.ts",
    "pretypecheck": "npm run content",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run content",
    "lint": "eslint .",
    "pretest": "npm run content",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:snippets": "tsx scripts/test-snippets.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:stale": "tsx scripts/check-stale.ts",
    "build": "npm run validate && npm run content && npm run typecheck && vite build",
    "verify": "npm run validate && npm run lint && npm run typecheck && npm test && npm run test:snippets && npm run build",
    "preview": "vite preview",
    "e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.68.0",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
